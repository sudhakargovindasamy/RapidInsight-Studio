PORT=3001

SUPABASE_URL=https://your-project.supabase.co/
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
INTERNAL_SERVICE_KEY=replace-with-shared-internal-key

DATABASE_URL=postgresql://user:password@host:6543/postgres

SCHEMA_BUCKET=schemas
MAX_SCHEMA_FILE_SIZE_MB=5

# Seed rows are generated here in the background when a schema is uploaded with
# "Generate mock data".
AI_SERVICE_URL=http://localhost:3005

# Seed generation is several batched provider calls, so it needs a long budget.
# It runs after the upload response is sent, so nothing waits on it.
SEED_REQUEST_TIMEOUT_MS=300000

# How long a schema may sit in "generating" before it is treated as abandoned.
# Generation lives only in the memory of the process that started it, so a
# restart leaves the row stuck forever; past this age it is reported as failed
# and can be retried. Must stay above SEED_REQUEST_TIMEOUT_MS.
SEED_STALE_AFTER_MS=420000
