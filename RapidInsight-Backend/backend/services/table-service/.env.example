PORT=3003

SUPABASE_URL=https://your-project.supabase.co/
SUPABASE_PUBLISHABLE_KEY=replace-me
INTERNAL_SERVICE_KEY=replace-with-shared-internal-key

DATABASE_URL=postgresql://user:password@host:6543/postgres

AI_SERVICE_URL=http://localhost:3005
DATAGEN_SERVICE_URL=http://localhost:3002

# Generation may train an SDV model per table on a cold run.
DATAGEN_TIMEOUT_MS=900000

# Spacing between AI steps, for free-tier per-minute rate limits.
AI_STEP_DELAY_MS=3000
