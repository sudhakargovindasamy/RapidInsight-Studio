PORT=3002

# Must match every other service's INTERNAL_SERVICE_KEY.
INTERNAL_SERVICE_KEY=replace-with-shared-internal-key

# The Python sidecar that trains and samples SDV models. There is no fallback
# generator, so data generation fails if this is not running.
SDV_SERVICE_URL=http://localhost:3008

# Cold generation trains a model per table. Warm generation samples in ~1s.
SDV_TIMEOUT_MS=300000
