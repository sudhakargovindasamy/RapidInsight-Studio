PORT=3005
INTERNAL_SERVICE_KEY=replace-with-shared-internal-key

# Provider used for every AI step. Switching providers is these three lines and
# nothing else - queueing, rate-limit backoff and retries are shared, so every
# provider behaves the same way under load.
#
#   groq         -> https://api.groq.com          e.g. llama-3.3-70b-versatile
#   gemini       -> Google Generative Language     e.g. gemini-2.5-flash
#   openai       -> https://api.openai.com         e.g. gpt-4o-mini
#   azure-openai -> your Azure OpenAI resource      e.g. your deployment name
#   claude       -> https://api.anthropic.com      e.g. claude-sonnet-5
#   grok         -> https://api.x.ai               e.g. grok-2-latest
#
# AI_MODEL must be a model the chosen provider actually serves - the name is
# passed through untouched. Remember SEED_AI_MODEL below has to match the
# provider too.
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=replace-with-provider-key

# Only used when AI_PROVIDER=azure-openai. Azure OpenAI is not a drop-in for
# openai: the model is selected by deployment name (not AI_MODEL) and auth
# uses an api-key header instead of a Bearer token.
#   AZURE_OPENAI_ENDPOINT    -> https://your-resource-name.openai.azure.com
#   AZURE_OPENAI_DEPLOYMENT  -> the deployment name you created in Azure AI
#                                Studio (falls back to AI_MODEL if unset)
#   AZURE_OPENAI_API_VERSION -> defaults to 2024-08-01-preview if unset
# AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Model for seed-row generation only. Leave unset to use AI_MODEL.
#
# Seed rows are the highest-volume and least demanding step - several calls per
# uploaded schema, all of it inventing plausible sample values. A small fast
# model handles that well, keeps uploads quick, and leaves the main model's rate
# limit for the reasoning steps. Must be a model the provider above serves.
SEED_AI_MODEL=llama-3.1-8b-instant

# Pause between seed-row batches. Seed generation makes several provider calls
# in quick succession, and free tiers rate-limit per minute.
SEED_BATCH_DELAY_MS=1500

# Quality gates for a seed batch. Defaults reject a batch that came back less
# than half full and fail a table with under 20 usable rows.
#
# Raise SEED_MAX_ROW_LOSS_RATIO towards 1 and lower SEED_MIN_USABLE_ROWS to let a
# poor run through so its output can be inspected - the way to see what a weak
# model actually writes rather than only seeing that it was rejected. Put both
# back to the defaults for real use: accepting short batches means fitting SDV on
# less data than the table deserves.
# SEED_MAX_ROW_LOSS_RATIO=0.95
# SEED_MIN_USABLE_ROWS=5

# Minimum gap between ANY two provider calls from this process. Seed jobs run in
# the background per upload, so several can be in flight at once; this paces all
# of them through one queue rather than per-job. Raise it if you still see 429s.
AI_MIN_REQUEST_GAP_MS=1200

# Longest we will wait out a rate limit before failing the request. Groq's free
# tier often asks for 30-60s, so a low value turns normal throttling into hard
# failures. Keep it under the caller's timeout (SEED_REQUEST_TIMEOUT_MS).
AI_MAX_RATE_LIMIT_WAIT_MS=90000

# Attempts per provider call, covering rate limits (429) and provider-side
# errors (5xx). A bad key, a bad prompt or any other 4xx fails immediately -
# those never improve by asking again.
AI_MAX_ATTEMPTS=3
