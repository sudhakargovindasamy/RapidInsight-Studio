PORT=3008

# Must match INTERNAL_SERVICE_KEY in the Node services. Requests are rejected the
# same way verifyInternalRequest rejects them.
INTERNAL_SERVICE_KEY=replace-me

# Where fitted synthesizers are stored. Relative paths resolve against the
# service directory. Surviving restarts is the point: a warm deploy skips
# training entirely.
SDV_ARTIFACT_DIR=.artifacts

# Artifacts kept on disk before the least recently used are evicted.
SDV_ARTIFACT_MAX_COUNT=200

# Fitted synthesizers held in memory. Loading a pickle costs ~100ms, so a small
# LRU in front of the disk cache makes repeat sampling effectively free.
SDV_MEMORY_CACHE_SIZE=16

# Hard ceilings. Fitting is CPU-bound and synchronous from the caller's point of
# view, so these are what stop one oversized request from stalling the service.
SDV_MAX_SEED_ROWS=5000
SDV_MAX_SAMPLE_ROWS=100000
SDV_MAX_COLUMNS=120

# Below this many seed rows a copula has nothing to learn - the covariance
# estimate is noise. The caller is told to serve its seed rows directly instead.
SDV_MIN_SEED_ROWS=20

# Threads available for fitting and sampling. numpy releases the GIL, so a small
# pool is enough to keep /health responsive while a fit is running.
SDV_WORKERS=2

# Quality scores run 0..1. Below this the response carries a warning; it does not
# fail, because the caller may still prefer imperfect data to none.
SDV_QUALITY_WARN_THRESHOLD=0.6

# TVAE training passes. 300 was enough for correlation ordering to hold in
# testing; raising it costs fit time roughly linearly.
SDV_TVAE_EPOCHS=300
SDV_CTGAN_EPOCHS=300