# Python virtual environment for sdv-service.
#
# Lives at the repo root rather than inside the service: SDV depends on torch,
# whose deeply nested files exceed the Windows 260-character path limit when the
# venv sits under backend/services/sdv-service/.
.venv-sdv/
.venv/
venv/
__pycache__/
*.pyc

